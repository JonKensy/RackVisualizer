# Copy to .env and fill in the real values. .env is gitignored — never commit it.
IDRAC_USER=root
IDRAC_PASSWORD=changeme

# Active Directory login (optional — set LDAP_SERVER to empty for local-only auth).
# The DC's self-signed certificate is not validated (trusted LAN).
LDAP_SERVER=ldaps://dc01.example.com:636
LDAP_USER_DN_TEMPLATE={username}@example.com
# Restrict AD logins to members of this security group (empty = allow all).
LDAP_GROUP_NAME=
